    <AssemblyName>SyndicateLauncher</AssemblyName>
    <IntermediateOutputPath>obj\Release\</IntermediateOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>E:\SnowLauncherBETA\OFFICIAL snow files\Launcher\SnowLauncher\obj\</MSBuildProjectExtensionsPath>
    <_TargetAssemblyProjectName>SyndicateLauncher</_TargetAssemblyProjectName>
    <RootNamespace>SyndicateLauncher</RootNamespace>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>SyndicateLauncher</RootNamespace>
    <ApplicationIcon>Assets\syndicate.ico</ApplicationIcon>
    <Version>1.3.1</Version>
    <PlatformTarget>x64</PlatformTarget>
    <Product>Project Snow Launcher</Product>
    <Company>Project Snow</Company>
    <Authors>Project Snow (fork of Syndicate by Unkn0wn (d4shyb0i), Joey, Sact, Trent, Alfie)</Authors>
    <Copyright>Copyright (c) 2026 Unkn0wn, Joey, Sact, Trent, and Alfie (Syndicate). Released under the MIT License.</Copyright>
    <Trademark>Project Snow</Trademark>
    <AssemblyTitle>Project Snow Launcher</AssemblyTitle>
    <Description>Project Snow Launcher, a fork of the open-source Syndicate launcher (MIT License).</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <!-- UPDATE FROM GIT.cmd builds with -p:SyndicateDevBuild=true: shows the DEV LAUNCHER badge. Release builds (build.bat) don't. -->
  <PropertyGroup Condition="'$(SyndicateDevBuild)'=='true'">
    <DefineConstants>$(DefineConstants);DEV_BUILD</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- Fortnite Lobby Themes: wallpapers and their card thumbnails (Models/LauncherTheme.cs, ThemeCatalog). -->
    <!-- Controller button hints (Settings > Mods > Controller, MainWindow.Controller.cs). -->
  </ItemGroup>
  <!-- Controllers: HidSharp reads PS4 / PS5 pads, Nefarius.ViGEm.Client turns them into a virtual Xbox pad
       (needs the free ViGEmBus driver). Both are bundled into the single-file exe. -->
  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.1.0" />
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Runtime\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <!--
    Obfuscation post-build step — Release builds only, never DEV_BUILD.
    Requires the Obfuscar local tool (run once: cd Launcher && dotnet tool restore).
    obfuscar.xml uses InPath=. and OutPath=.\obf (relative to WorkingDirectory=TargetDir).
    After Obfuscar finishes, the obfuscated DLL is copied back over the original
    and the temp obf\ folder is removed. DEV builds skip this entirely.
  -->
  <Target Name="ObfuscateAssembly" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' And '$(SyndicateDevBuild)' != 'true'">
    <PropertyGroup>
      <_ObfDir>$(TargetDir)obf\</_ObfDir>
    </PropertyGroup>
    <MakeDir Directories="$(_ObfDir)" />
    <Message Text="[Syndicate] Restoring Obfuscar tool..." Importance="high" />
    <Exec Command="dotnet tool restore" WorkingDirectory="$(MSBuildThisFileDirectory).." ContinueOnError="true" />
    <Message Text="[Syndicate] Running Obfuscar on $(TargetName)..." Importance="high" />
    <Exec Command="dotnet tool run obfuscar.console &quot;$(MSBuildThisFileDirectory)obfuscar.xml&quot;" WorkingDirectory="$(TargetDir)" ContinueOnError="true" />
    <!-- Fail the Release build if obfuscation did not run, instead of silently shipping a plain DLL. -->
    <Error Condition="!Exists('$(_ObfDir)SyndicateLauncher.dll')" Text="Obfuscation did not produce $(_ObfDir)SyndicateLauncher.dll. Run 'cd Launcher &amp;&amp; dotnet tool restore' and rebuild. A Release build must not ship an unobfuscated launcher." />
    <!-- Copy the obfuscated DLL back over the original once MSBuild has released its handle -->
    <Copy SourceFiles="$(_ObfDir)SyndicateLauncher.dll" DestinationFiles="$(TargetPath)" Condition="Exists('$(_ObfDir)SyndicateLauncher.dll')" OverwriteReadOnlyFiles="true" />
    <!-- Keep the symbol map next to the DLL for offline crash-trace decoding -->
    <Copy SourceFiles="$(_ObfDir)Mapping.xml" DestinationFolder="$(TargetDir)" Condition="Exists('$(_ObfDir)Mapping.xml')" />
    <RemoveDir Directories="$(_ObfDir)" />
    <Message Text="[Syndicate] Obfuscation applied." Importance="high" />
  </Target>
  <Target Name="EmbedSyndicateRuntime" BeforeTargets="AssignTargetPaths">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <ZipDirectory SourceDirectory="$(MSBuildProjectDirectory)\Runtime" DestinationFile="$(IntermediateOutputPath)SyndicateRuntime.zip" Overwrite="true" />
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)SyndicateRuntime.zip" LogicalName="SyndicateLauncher.Runtime.zip" />
    </ItemGroup>
  </Target>
